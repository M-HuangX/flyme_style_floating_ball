    <string name="hyperos_guide_title">HyperOS Setup Guide</string>
    <string name="hyperos_guide_text">
        1. Enable Accessibility Service\n
        2. Grant \"Display over other apps\" permission\n
        3. Set Battery to \"No restrictions\"\n
        4. Enable Autostart\n
        5. Lock app in Recent tasks (swipe down on app card → tap lock icon)
    </string>
