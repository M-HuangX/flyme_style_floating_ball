    <string name="app_name">Floating Ball</string>
    <string name="settings_title">Settings</string>
    <string name="accessibility_service_description">
        Floating Ball provides a convenient floating navigation ball that lets you
        perform Back, Home, Notifications, One-Handed Mode, and other actions with
        simple gestures. This service requires accessibility access to perform
        global actions and simulate one-handed mode gestures on HyperOS devices.
    </string>
    <string name="notification_channel_name">Floating Ball Service</string>
    <string name="notification_channel_description">
        Persistent notification required to keep the floating ball running.
    </string>
