<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay permission for WindowManager floating ball -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service permissions (Android 14+ requires declared type) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- One-handed mode: Settings.Secure write (needs ADB grant via USB debugging Security settings) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Boot completed for auto-restart after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Schedule exact alarms for health checks -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:testOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloatingBall">

        <!-- Launcher Activity: guides user to enable accessibility -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/settings_title"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- App Picker for Auto-Hide (disabled for now, orientation-based detection used instead)
        <activity
            android:name=".ui.AppPickerActivity"
            android:label="Auto-Hide Apps"
            android:exported="false" />
        -->

        <!-- Notification Listener: auto-dismiss "displaying over other apps" notification -->
        <service
            android:name=".service.NotificationDismissService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Health check: periodic auto-restart watchdog -->
        <receiver
            android:name=".service.HealthCheckReceiver"
            android:exported="false" />

        <!-- Boot receiver: restart checks after reboot -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Accessibility Service = foreground service + overlay manager -->
        <service
            android:name=".service.FloatingBallService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="This accessibility service maintains a floating navigation ball overlay for quick system actions (back, home, notifications, one-handed mode). A persistent foreground notification is required so the system does not kill the overlay or the accessibility connection. Without foreground status, Android 14+ aggressively stops background accessibility services." />
        </service>

    </application>
</manifest>
